# ==============================================================================
# Laravel & Cooca .gitignore
# ==============================================================================

# --- Environment & Credentials (CRITICAL) ---
.env
.env.backup
.env.production
.env.local
.env.*.local
.env.testing
!.env.example
/auth.json
/storage/*.key
oauth-*.json
*.pem
cloudflared.exe
config.yml
*.exe

# --- Database ---
*.sqlite
database/*.sqlite
database/database.sqlite

# --- Python ---
__pycache__/
*.pyc

# --- PHP & Composer ---
/vendor/
composer.phar
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php
.phpunit.result.cache
/.phpunit.cache
.phpactor.json

# --- Node & Frontend Dependencies ---
/node_modules/
/public/build
/public/hot
/public/storage
/public/bisnis
/public/payment-proofs/*
!/public/payment-proofs/.gitkeep
/public/admin/*
!/public/admin/.gitkeep
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- WhatsApp Gateway (wa-server) ---
# Microservice mandiri (memiliki Git repository sendiri untuk deploy ke Render.com/VPS)
/wa-server/
.baileys_auth/
whatsapp-web.js/
/wa-server.zip

# --- Laravel Storage & Cache ---
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public
/storage/app/public/*
!/storage/app/public/.gitignore

/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore

/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore

/storage/framework/testing/*
!/storage/framework/testing/.gitignore

/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/*.php

/storage/logs/*
!/storage/logs/.gitignore
/storage/pail

# --- Log Files ---
*.log
cron*.log

# --- IDEs & Code Editors ---
.idea/
.vscode/
/.cursor/
/.codex/
/.nova/
/.zed/
*.sublime-project
*.sublime-workspace

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Server Specific ---
Homestead.json
Homestead.yaml
.vagrant/
/scratch/

# --- Audit & Diagnostic Dumps ---
routes.json
scan_report*.txt
scratch_*.py
temp_mcp_render.html
