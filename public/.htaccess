<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    # Disable DirectorySlash so Apache doesn't auto-redirect routes matching directory names
    <IfModule mod_dir.c>
        DirectorySlash Off
    </IfModule>

    RewriteEngine On
    
    # Canonical redirect: If /public/ is in the raw browser request, redirect to clean URL
    RewriteCond %{THE_REQUEST} \s/+public(?:/([^\s?]*))? [NC]
    RewriteRule ^ /%1 [L,R=301,NE]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-Business-Id Header for Mobile & API
    RewriteCond %{HTTP:X-Business-Id} .
    RewriteRule .* - [E=HTTP_X_BUSINESS_ID:%{HTTP:X-Business-Id}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Block access to hidden files and sensitive credentials
    RewriteRule ^(\.env|\.git|\.well-known/.*$|\.ht.*) - [F,L,NC]
    RewriteRule \.(key|pem|log|sql|sh|yml|yaml|lock|bak|config)$ - [F,L,NC]

    # Block script execution in uploads directory
    RewriteRule ^(bisnis|storage|admin)/.*\.(php|phtml|php[0-9]|phps|cgi|pl|py|sh|exe)$ - [F,L,NC]

    # Ensure Laravel handles /admin and /admin/* routes when not requesting a physical static file
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} ^/admin(/.*)?$ [NC]
    RewriteRule ^ index.php [L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Static Asset Long-Term Caching (Optimizes Lighthouse Cache Policy & Repeat Visits)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff2?|css|js)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
</IfModule>

